    {
      "id": "5h0wca5e-0003-4000-8000-000000000003",
      "name": "Tidy the answers",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const j = $input.first().json, t = v => String(v || '').trim().replace(/\\s+/g, ' ');\n  return [{ json: { name: t(j['Full name']), email: t(j['Email']).toLowerCase(), phone: t(j['Phone']), matter: t(j['Type of matter']), otherParty: t(j[\"Other party's name (if any)\"]), details: String(j['What do you need help with?'] || '').trim(), received: new Date().toISOString() } }];"
      }
    },
