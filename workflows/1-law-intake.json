    {
      "id": "5h0wca5e-0003-4000-8000-000000000005",
      "name": "Conflict check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Exact rule, done in code (not by AI): does the new client or the other party match anyone we already act for or against?\n  const intake = $('Tidy the answers').first().json;\n  const norm = s => String(s || '').toLowerCase().replace(/\\b(llc|llp|inc|ltd|co|corp|group|the)\\b|[^a-z0-9 ]/g, ' ').split(/\\s+/).filter(Boolean);\n  const same = (a, b) => { const A = norm(a), B = norm(b); if (!A.length || !B.length) return false; const hit = A.filter(w => B.includes(w)).length; return hit >= Math.min(2, Math.min(A.length, B.length)) && hit / Math.min(A.length, B.length) >= 0.99; };\n  const hits = [];\n  for (const row of $input.all().map(i => i.json)) {\n    if (same(intake.otherParty, row.Name) && row.Role === 'Client') hits.push(`The other party, ${intake.otherParty}, is an existing client (${row.Matter}).`);\n    if (same(intake.name, row.Name) && row.Role === 'Opposing party') hits.push(`${intake.name} is the opposing party in an open matter (${row.Matter}).`);\n  }\n  return [{ json: { ...intake, conflict: hits.length > 0, conflictNote: hits.join(' ') || 'Clear: no match in the client list.' } }];"
      }
    },
    {
      "id": "5h0wca5e-0003-4000-8000-000000000006",
      "name": "Build Claude request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const j = $json;\n  const prompt = `You help a small law office triage new-client enquiries. Read the enquiry and reply with ONLY a JSON object:\n{\"summary\": \"2 sentences, plain English, no legal advice\", \"practiceArea\": one of [\"Real estate\", \"Estate planning\", \"Landlord-tenant\", \"Other\"], \"urgency\": one of [\"Low\", \"Normal\", \"High\"], \"scope\": \"one sentence describing the work the firm would do, starting with a verb\"}\nUrgency is High only if a deadline within 14 days is mentioned.\n\nMatter type chosen: ${j.matter}\nOther party: ${j.otherParty || 'none given'}\nEnquiry: ${j.details}`;\n  return [{ json: { ...j, body: { model: 'claude-sonnet-5-5', max_tokens: 600, messages: [{ role: 'user', content: prompt }] } } }];"
      }
    },
    {
      "id": "5h0wca5e-0003-4000-8000-000000000007",
      "name": "Claude: summarise and classify",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "options": {
          "timeout": 120000
        },
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "anthropicApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "id": "5h0wca5e-0003-4000-8000-000000000008",
      "name": "Check Claude's answer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const raw = ($json.content || []).filter(c => c.type === 'text').map(c => c.text).join('');\nlet ai = null;\nfor (let i = raw.indexOf('{'); i >= 0 && !ai; i = raw.indexOf('{', i + 1)) {\n  let depth = 0, inStr = false, esc = false;\n  for (let k = i; k < raw.length; k++) {\n    const ch = raw[k];\n    if (inStr) { if (esc) esc = false; else if (ch === '\\\\') esc = true; else if (ch === '\"') inStr = false; }\n    else if (ch === '\"') inStr = true;\n    else if (ch === '{') depth++;\n    else if (ch === '}' && --depth === 0) { try { ai = JSON.parse(raw.slice(i, k + 1)); } catch (e) {} break; }\n  }\n}\nif (!ai) throw new Error('Claude did not return JSON: ' + raw.slice(0, 200));\n  const intake = $('Conflict check').first().json;\n  const pick = (v, list, d) => (list.includes(v) ? v : d);\n  return [{ json: { ...intake, summary: String(ai.summary || '').slice(0, 600), practiceArea: pick(ai.practiceArea, ['Real estate', 'Estate planning', 'Landlord-tenant', 'Other'], 'Other'), urgency: pick(ai.urgency, ['Low', 'Normal', 'High'], 'Normal'), scope: String(ai.scope || 'Advise on the matter described in your enquiry').slice(0, 300) } }];"
      }
    },
