    {
      "id": "5h0wca5e-0003-4000-8000-000000000013",
      "name": "Draft the letter",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        120
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const j = $json, today = new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });\n  const title = 'ENGAGEMENT LETTER';\n  const text = `${title}\\n\\nHartwell & Reed LLP\\n${today}\\n\\n${j.name}\\n${j.email}\\n\\nDear ${j.name.split(' ')[0]},\\n\\nThank you for contacting Hartwell & Reed LLP. This letter confirms the terms on which we will act for you.\\n\\n1. Scope of work\\nWe will: ${j.scope.replace(/\\.$/, '')}. Matter type: ${j.matter} (${j.practiceArea}).\\n\\n2. Who will handle your matter\\nYour matter will be handled by the attorney named in the signature below, supported by our paralegal team.\\n\\n3. Fees\\nOur fees are set out in the attached fee schedule, which forms part of this letter. We will tell you before doing any work outside the scope above.\\n\\n4. Conflicts\\nWe have checked our records and found no conflict of interest in acting for you${j.otherParty ? ' in a matter involving ' + j.otherParty : ''}.\\n\\n5. Next step\\nPlease sign and return this letter. We will start work once we receive it.\\n\\nYours sincerely,\\n\\n______________________\\nAttorney, Hartwell & Reed LLP\\n\\nAccepted by: ______________________   Date: ____________\\n`;\n  const requests = [{ insertText: { location: { index: 1 }, text } }, { updateParagraphStyle: { range: { startIndex: 1, endIndex: 1 + title.length }, paragraphStyle: { namedStyleType: 'TITLE' }, fields: 'namedStyleType' } }];\n  return [{ json: { ...j, docTitle: `Engagement letter - ${j.name}`, requests } }];"
      }
    },
