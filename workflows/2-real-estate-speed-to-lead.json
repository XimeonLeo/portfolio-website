        "formFields": {
          "values": [
            {
              "fieldLabel": "Name",
              "requiredField": true
            },
            {
              "fieldLabel": "Email",
              "fieldType": "email",
              "requiredField": true
            },
            {
              "fieldLabel": "Mobile number",
              "requiredField": true
            },
            {
              "fieldLabel": "I am interested in",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Buying"
                  },
                  {
                    "option": "Selling"
                  },
                  {
                    "option": "Renting"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Area or property",
              "requiredField": true
            },
            {
              "fieldLabel": "Budget"
            },
            {
              "fieldLabel": "When do you want to move?",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "As soon as possible"
                  },
                  {
                    "option": "Within 3 months"
                  },
                  {
                    "option": "3 to 6 months"
                  },
                  {
                    "option": "Just looking"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Anything else?",
              "fieldType": "textarea"
            }
          ]
        },
        "options": {
          "appendAttribution": false
        }
      },
      "webhookId": "5h0wca5e-0004-4000-8000-000000000001"
