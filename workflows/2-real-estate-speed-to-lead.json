    {
      "id": "5h0wca5e-0004-4000-8000-000000000005",
      "name": "Tidy the lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const j = $input.first().json, b = j.body || null, t = v => String(v || '').trim();\n  const lead = b ? { name: t(b.callerName) || 'Unknown caller', email: '', phone: t(b.from), source: 'Missed call', interest: 'Unknown', area: '', budget: '', timeline: 'Unknown', message: '' }\n    : { name: t(j['Name']), email: t(j['Email']).toLowerCase(), phone: t(j['Mobile number']), source: 'Website form', interest: t(j['I am interested in']), area: t(j['Area or property']), budget: t(j['Budget']), timeline: t(j['When do you want to move?']), message: t(j['Anything else?']) };\n  return [{ json: { ...lead, receivedAt: Date.now(), received: new Date().toISOString().slice(0, 19).replace('T', ' ') } }];"
      }
    },
    {
      "id": "5h0wca5e-0004-4000-8000-000000000006",
      "name": "Score the lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// The score is rules in code, so it is the same every time and the agent can see why.\n  const j = $json, why = []; let score = 20;\n  const add = (n, r) => { score += n; why.push(r); };\n  if (j.timeline === 'As soon as possible') add(35, 'wants to move now'); else if (j.timeline === 'Within 3 months') add(25, 'moving within 3 months'); else if (j.timeline === '3 to 6 months') add(10, '3 to 6 months out');\n  if (/\\d/.test(j.budget)) add(15, 'gave a budget');\n  if (j.interest === 'Selling') add(15, 'has a property to sell'); else if (j.interest === 'Buying') add(10, 'buyer');\n  if (j.area) add(5, 'named an area');\n  if (j.source === 'Missed call') add(30, 'called us directly');\n  score = Math.min(100, score);\n  return [{ json: { ...j, score, temperature: score >= 70 ? 'Hot' : score >= 45 ? 'Warm' : 'Cold', hot: score >= 70, why: why.join(', ') || 'little information yet' } }];"
      }
    },
    {
      "id": "5h0wca5e-0004-4000-8000-000000000007",
      "name": "Build Claude request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const j = $json;\n  const prompt = `You write the first text message a real estate agency sends to a new lead. Agency: Lakeshore Realty. Agent: Maya.\nRules: under 320 characters, friendly and specific to what they asked, no emojis, no promises about price or availability, end with ONE easy question that moves things forward. If we only have a missed call, apologise for missing it and ask what they are looking for.\nReply with ONLY a JSON object: {\"sms\": \"...\"}\n\nLead: ${JSON.stringify({ name: j.name, source: j.source, interest: j.interest, area: j.area, budget: j.budget, timeline: j.timeline, message: j.message })}`;\n  return [{ json: { ...j, body: { model: 'claude-sonnet-5-5', max_tokens: 400, messages: [{ role: 'user', content: prompt }] } } }];"
      }
    },
    {
      "id": "5h0wca5e-0004-4000-8000-000000000008",
      "name": "Claude: write the first reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "options": {
          "timeout": 120000
        },
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "anthropicApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "id": "5h0wca5e-0004-4000-8000-000000000009",
      "name": "Check the reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const raw = ($json.content || []).filter(c => c.type === 'text').map(c => c.text).join('');\nlet ai = null;\nfor (let i = raw.indexOf('{'); i >= 0 && !ai; i = raw.indexOf('{', i + 1)) {\n  let depth = 0, inStr = false, esc = false;\n  for (let k = i; k < raw.length; k++) {\n    const ch = raw[k];\n    if (inStr) { if (esc) esc = false; else if (ch === '\\\\') esc = true; else if (ch === '\"') inStr = false; }\n    else if (ch === '\"') inStr = true;\n    else if (ch === '{') depth++;\n    else if (ch === '}' && --depth === 0) { try { ai = JSON.parse(raw.slice(i, k + 1)); } catch (e) {} break; }\n  }\n}\nif (!ai) throw new Error('Claude did not return JSON: ' + raw.slice(0, 200));\n  const lead = $('Score the lead').first().json;\n  let sms = String(ai.sms || '').trim();\n  if (!sms || sms.length > 480) sms = `Hi ${lead.name.split(' ')[0]}, this is Maya at Lakeshore Realty. Thanks for getting in touch. When is a good time for a quick call today?`;\n  return [{ json: { ...lead, sms, repliedIn: Math.max(1, Math.round((Date.now() - lead.receivedAt) / 1000)) } }];"
      }
    },
