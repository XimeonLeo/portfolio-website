    {
      "id": "5h0wca5e-0004-4000-8000-000000000014",
      "name": "Next viewing slots",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        -140
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const lead = $('Check the reply').first().json, slots = [], d = new Date();\n  while (slots.length < 3) { d.setDate(d.getDate() + 1); if (d.getDay() % 6) slots.push(d.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' }) + (slots.length % 2 ? ' 4:00 pm' : ' 10:30 am')); }\n  return [{ json: { ...lead, alert: `HOT LEAD (${lead.score}/100): ${lead.name}, ${lead.phone}. ${lead.interest}${lead.area ? ' in ' + lead.area : ''}${lead.budget ? ', budget ' + lead.budget : ''}. Why: ${lead.why}. Already texted back in ${lead.repliedIn}s. Open slots to offer: ${slots.join(' / ')}.` } }];"
      }
    },
