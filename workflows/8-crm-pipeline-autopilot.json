      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const d = $input.all().map(i => i.json), open = d.filter(x => !['Won', 'Lost'].includes(x.stage));\n  const sum = a => a.reduce((s, x) => s + x.value, 0).toLocaleString('en-US');\n  const risk = d.filter(x => x.health === 'At risk'), fu = d.filter(x => x.health === 'Needs follow-up');\n  return [{ json: { text: `Pipeline this morning: ${open.length} open deals worth $${sum(open)}. At risk: ${risk.map(x => x.company + ' (' + x.idle + ' days quiet)').join(', ') || 'none'}. Needs follow-up: ${fu.map(x => x.company).join(', ') || 'none'}. Won: ${d.filter(x => x.stage === 'Won').map(x => x.company).join(', ') || 'none'}. ${d.reduce((s, x) => s + x.tasks.length, 0)} tasks created.` } }];"
      }
