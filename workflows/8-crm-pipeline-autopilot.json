    {
      "id": "5h0wca5e-0012-4000-8000-000000000010",
      "name": "Build Claude request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        120
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const j = $json;\n  const prompt = `Write a short follow-up email from ${j.owner} at Northbeam Studio to ${j.contact} at ${j.company}.\nSituation: the deal is at the \"${j.stage}\" stage and there has been no contact for ${j.idle} days.\nRules: under 90 words, friendly, no pressure, no discounts or prices, one clear question at the end. Plain text.\nReply with ONLY a JSON object: {\"subject\": \"\", \"body\": \"\"}`;\n  return { json: { ...j, body: { model: 'claude-sonnet-5-5', max_tokens: 400, messages: [{ role: 'user', content: prompt }] } } };"
      }
    },
    {
      "id": "5h0wca5e-0012-4000-8000-000000000011",
      "name": "Claude: draft the follow-up",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        120
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "options": {
          "timeout": 120000
        },
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "anthropicApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "id": "5h0wca5e-0012-4000-8000-000000000012",
      "name": "Check the draft",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        120
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const raw = ($json.content || []).filter(c => c.type === 'text').map(c => c.text).join('');\nlet ai = null;\nfor (let i = raw.indexOf('{'); i >= 0 && !ai; i = raw.indexOf('{', i + 1)) {\n  let depth = 0, inStr = false, esc = false;\n  for (let k = i; k < raw.length; k++) {\n    const ch = raw[k];\n    if (inStr) { if (esc) esc = false; else if (ch === '\\\\') esc = true; else if (ch === '\"') inStr = false; }\n    else if (ch === '\"') inStr = true;\n    else if (ch === '{') depth++;\n    else if (ch === '}' && --depth === 0) { try { ai = JSON.parse(raw.slice(i, k + 1)); } catch (e) {} break; }\n  }\n}\nif (!ai) throw new Error('Claude did not return JSON: ' + raw.slice(0, 200));\n  const d = $('Build Claude request').item.json;\n  let body = String(ai.body || '').trim();\n  if (!body || /[$£€]\\s?\\d|discount/i.test(body)) body = `Hi ${d.contact.split(' ')[0]}, I wanted to check in on where things stand. Is there anything you need from me to move forward?`;\n  return { json: { id: d.id, contact: d.contact, text: 'Subject: ' + String(ai.subject || 'Checking in').slice(0, 90) + '\\n\\n' + body.slice(0, 900) } };"
      }
    },
