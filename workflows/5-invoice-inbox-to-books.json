    {
      "id": "5h0wca5e-0007-4000-8000-000000000007",
      "name": "Seen before?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const inv = $('Check the maths').first().json, key = s => String(s || '').toLowerCase().replace(/[^a-z0-9]/g, '');\n  const dup = $input.all().map(i => i.json).find(r => key(r['Invoice no']) === key(inv.invoiceNumber) && key(r.Vendor) === key(inv.vendor) && inv.invoiceNumber);\n  const problems = [...inv.problems, ...(dup ? [`Duplicate: invoice ${inv.invoiceNumber} from ${inv.vendor} was already logged on ${dup.Logged}`] : [])];\n  return [{ json: { ...inv, problems, ok: problems.length === 0, link: 'https://drive.google.com/file/d/' + inv.fileId + '/view' } }];"
      }
    },
