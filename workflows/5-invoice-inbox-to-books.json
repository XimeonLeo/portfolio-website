    {
      "id": "5h0wca5e-0007-4000-8000-000000000003",
      "name": "Build Claude request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const file = $input.first(), buf = await this.helpers.getBinaryDataBuffer(0, 'data');\n  const prompt = `Read this invoice and reply with ONLY a JSON object, copying the numbers exactly as printed (do not correct them):\n{\"vendor\": \"\", \"invoiceNumber\": \"\", \"invoiceDate\": \"YYYY-MM-DD\", \"dueDate\": \"YYYY-MM-DD or empty\", \"currency\": \"USD\", \"lines\": [{\"description\": \"\", \"quantity\": 0, \"unitPrice\": 0, \"amount\": 0}], \"subtotal\": 0, \"tax\": 0, \"total\": 0}`;\n  return [{ json: { fileId: file.json.id, fileName: file.json.name, body: { model: 'claude-sonnet-5-5', max_tokens: 1500, messages: [{ role: 'user', content: [{ type: 'document', source: { type: 'base64', media_type: 'application/pdf', data: buf.toString('base64') } }, { type: 'text', text: prompt }] }] } } }];"
      }
    },
    {
      "id": "5h0wca5e-0007-4000-8000-000000000004",
      "name": "Claude: read the invoice",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "options": {
          "timeout": 120000
        },
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "anthropicApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "id": "5h0wca5e-0007-4000-8000-000000000005",
      "name": "Check the maths",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const raw = ($json.content || []).filter(c => c.type === 'text').map(c => c.text).join('');\nlet ai = null;\nfor (let i = raw.indexOf('{'); i >= 0 && !ai; i = raw.indexOf('{', i + 1)) {\n  let depth = 0, inStr = false, esc = false;\n  for (let k = i; k < raw.length; k++) {\n    const ch = raw[k];\n    if (inStr) { if (esc) esc = false; else if (ch === '\\\\') esc = true; else if (ch === '\"') inStr = false; }\n    else if (ch === '\"') inStr = true;\n    else if (ch === '{') depth++;\n    else if (ch === '}' && --depth === 0) { try { ai = JSON.parse(raw.slice(i, k + 1)); } catch (e) {} break; }\n  }\n}\nif (!ai) throw new Error('Claude did not return JSON: ' + raw.slice(0, 200));\n  // AI reads; code checks. Money is compared in cents so rounding cannot hide a mistake.\n  const src = $('Build Claude request').first().json, cents = v => Math.round(Number(v) * 100), problems = [];\n  const lines = Array.isArray(ai.lines) ? ai.lines : [];\n  if (!ai.vendor) problems.push('No vendor name found');\n  if (!ai.invoiceNumber) problems.push('No invoice number found');\n  if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(ai.invoiceDate || '')) problems.push('Invoice date could not be read');\n  if (!(Number(ai.total) > 0)) problems.push('Total is missing or zero');\n  const lineSum = lines.reduce((s, l) => s + cents(l.amount), 0);\n  for (const l of lines) if (cents(l.quantity * l.unitPrice) !== cents(l.amount)) problems.push(`Line \"${String(l.description).slice(0, 40)}\": ${l.quantity} x ${l.unitPrice} is not ${l.amount}`);\n  if (lines.length && lineSum !== cents(ai.subtotal)) problems.push(`Lines add up to ${(lineSum / 100).toFixed(2)} but the subtotal says ${Number(ai.subtotal).toFixed(2)}`);\n  if (cents(ai.subtotal) + cents(ai.tax || 0) !== cents(ai.total)) problems.push(`Subtotal + tax is ${((cents(ai.subtotal) + cents(ai.tax || 0)) / 100).toFixed(2)} but the total says ${Number(ai.total).toFixed(2)}`);\n  return [{ json: { ...src, body: undefined, vendor: String(ai.vendor || ''), invoiceNumber: String(ai.invoiceNumber || ''), invoiceDate: ai.invoiceDate || '', dueDate: ai.dueDate || '', currency: ai.currency || 'USD', subtotal: Number(ai.subtotal) || 0, tax: Number(ai.tax) || 0, total: Number(ai.total) || 0, lineCount: lines.length, problems } }];"
      }
    },
