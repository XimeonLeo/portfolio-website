    {
      "id": "5h0wca5e-0005-4000-8000-000000000004",
      "name": "What is due?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Plain rules. Each appointment can need at most one message per run.\n  const now = Date.now(), H = 3600e3, due = [];\n  for (const a of $input.all().map(i => i.json)) {\n    const start = new Date(String(a.Starts).replace(' ', 'T')).getTime(); if (!a['Appt ID'] || isNaN(start)) continue;\n    const until = (start - now) / H, first = String(a.Patient).split(' ')[0];\n    const when = new Date(start).toLocaleString('en-US', { weekday: 'long', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });\n    const base = { id: a['Appt ID'], patient: a.Patient, first, phone: a.Phone, when };\n    if (a.Status === 'No-show' && !a['Rebook offer']) due.push({ ...base, type: 'No-show', column: 'Rebook offer' });\n    else if (a.Status === 'Completed' && !a['Review request'] && until < -2) due.push({ ...base, type: 'Review', column: 'Review request' });\n    else if (['Booked', 'Confirmed'].includes(a.Status) && until > 0 && until <= 2 && !a['Reminder 2h']) due.push({ ...base, type: '2 hours', column: 'Reminder 2h' });\n    else if (a.Status === 'Booked' && until > 2 && until <= 48 && !a['Reminder 48h']) due.push({ ...base, type: '48 hours', column: 'Reminder 48h' });\n  }\n  return due.map(json => ({ json }));"
      }
    },
