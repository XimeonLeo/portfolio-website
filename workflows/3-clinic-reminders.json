        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all().map(i => i.json); if (!items.length) return [];\n  const count = t => items.filter(i => i.type === t).length;\n  const noshow = items.filter(i => i.type === 'No-show').map(i => i.patient).join(', ');\n  return [{ json: { text: `This run: ${count('48 hours')} reminder(s) for the day after tomorrow, ${count('2 hours')} for today, ${count('No-show')} rebooking offer(s), ${count('Review')} review request(s).${noshow ? ' To call if they do not rebook: ' + noshow + '.' : ''}` } }];"
      }
