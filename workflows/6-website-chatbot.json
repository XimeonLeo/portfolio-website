      "waitBetweenTries": 3000,
      "executeOnce": true,
      "alwaysOutputData": true
    },
    {
      "id": "5h0wca5e-0010-4000-8000-000000000005",
      "name": "Load the conversation",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        660,
        0
      ],
      "parameters": {
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "RUN-SETUP-FIRST"
        },
        "sheetName": {
