    {
      "id": "5h0wca5e-0010-4000-8000-000000000006",
      "name": "Build Claude request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const m = $('Tidy the message').first().json;\n  const facts = $('Load what the bot knows').all().map(i => i.json).filter(r => r.Business === m.business).map(r => `- ${r.Topic}: ${r.Answer}`).join('\\n');\n  const history = $('Load the conversation').all().map(i => i.json).filter(r => r.Session === m.session).slice(-12).map(r => ({ role: r.Who === 'Visitor' ? 'user' : 'assistant', content: String(r.Message) }));\n  const system = `You are the website assistant for Whitfield Leadership Coaching. Be warm, brief (under 60 words) and plain. No emojis.\nAnswer ONLY from these notes. If the notes do not cover it, say you are not sure and offer a discovery call. Never quote a price.\nNOTES:\n${facts}\n\nYour goal is to help, then offer the free discovery call when it fits. To book it you need the visitor's name and email: ask for whichever is missing, one question at a time.\nReply with ONLY a JSON object: {\"reply\": \"what you say to the visitor\", \"lead\": {\"name\": \"\", \"email\": \"\", \"interest\": \"one short line\"} or null}\nFill \"lead\" only once you have BOTH a name and an email from the visitor's own messages.`;\n  return [{ json: { ...m, body: { model: 'claude-sonnet-5-5', max_tokens: 500, system, messages: [...history, { role: 'user', content: m.text }] } } }];"
      }
    },
    {
      "id": "5h0wca5e-0010-4000-8000-000000000007",
      "name": "Claude: write the reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "options": {
          "timeout": 120000
        },
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "anthropicApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "id": "5h0wca5e-0010-4000-8000-000000000008",
      "name": "Check the reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const raw = ($json.content || []).filter(c => c.type === 'text').map(c => c.text).join('');\nlet ai = null;\nfor (let i = raw.indexOf('{'); i >= 0 && !ai; i = raw.indexOf('{', i + 1)) {\n  let depth = 0, inStr = false, esc = false;\n  for (let k = i; k < raw.length; k++) {\n    const ch = raw[k];\n    if (inStr) { if (esc) esc = false; else if (ch === '\\\\') esc = true; else if (ch === '\"') inStr = false; }\n    else if (ch === '\"') inStr = true;\n    else if (ch === '{') depth++;\n    else if (ch === '}' && --depth === 0) { try { ai = JSON.parse(raw.slice(i, k + 1)); } catch (e) {} break; }\n  }\n}\nif (!ai) throw new Error('Claude did not return JSON: ' + raw.slice(0, 200));\n  const m = $('Build Claude request').first().json;\n  let reply = String(ai.reply || '').trim().slice(0, 700) || 'Sorry, I did not catch that. Could you say it another way?';\n  if (/[$£€]\\s?\\d/.test(reply)) reply = 'Prices depend on the programme, and Dana confirms them on a free discovery call. Would you like me to set one up?';\n  const l = ai.lead || {}, emailOk = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(String(l.email || ''));\n  const lead = l.name && emailOk ? { name: String(l.name).slice(0, 80), email: String(l.email).toLowerCase(), interest: String(l.interest || '').slice(0, 160) } : null;\n  return [{ json: { session: m.session, channel: m.channel, time: m.time, text: m.text, reply, lead, isLead: !!lead } }];"
      }
    },
    {
      "id": "5h0wca5e-0010-4000-8000-000000000009",
      "name": "Send the reply back",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1540,
        0
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ reply: $json.reply, lead: $json.isLead }) }}",
        "options": {}
      }
    },
    {
      "id": "5h0wca5e-0010-4000-8000-000000000010",
      "name": "Two log lines",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
