      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const j = $('Check the reply').first().json;\n  return [{ json: { time: j.time, channel: j.channel, session: j.session, who: 'Visitor', message: j.text } }, { json: { time: j.time, channel: j.channel, session: j.session, who: 'Assistant', message: j.reply } }];"
