    {
      "id": "5h0wca5e-0010-4000-8000-000000000002",
      "name": "Message from the website chat",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "demo-web-chat",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "5h0wca5e-0010-4000-8000-000000000001"
