    {
      "id": "5h0wca5e-0010-4000-8000-000000000003",
      "name": "Tidy the message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b = $input.first().json.body || {};\n  const text = String(b.text || '').trim().slice(0, 1000), session = String(b.session || 'anon').replace(/[^a-zA-Z0-9-]/g, '').slice(0, 40) || 'anon';\n  if (!text) throw new Error('Empty message');\n  return [{ json: { text, session, channel: 'Website', business: 'Whitfield Coaching', time: new Date().toISOString().slice(0, 19).replace('T', ' ') } }];"
      }
    },
    {
      "id": "5h0wca5e-0010-4000-8000-000000000004",
      "name": "Load what the bot knows",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        440,
        0
      ],
      "parameters": {
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "RUN-SETUP-FIRST"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Bot Knowledge"
        },
        "options": {}
      },
      "retryOnFail": true,
