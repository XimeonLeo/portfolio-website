      "name": "Tidy the message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b = $input.first().json.body || {};\n  const text = String(b.text || '').trim().slice(0, 1000), session = String(b.session || 'anon').replace(/[^a-zA-Z0-9-]/g, '').slice(0, 40) || 'anon';\n  if (!text) throw new Error('Empty message');\n  return [{ json: { text, session, phone: String(b.from || '+1 503 555 0190'), channel: 'WhatsApp', business: 'Brightside Clinic', time: new Date().toISOString().slice(0, 19).replace('T', ' ') } }];"
