    {
      "id": "5h0wca5e-0011-4000-8000-000000000007",
      "name": "Work out open slots",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// The calendar is worked out in code, so the bot can only ever offer a slot that is really free.\n  const taken = new Set($('Load bookings').all().map(i => i.json).filter(b => b.Day).map(b => b.Day + ' ' + b.Time));\n  const open = [], d = new Date();\n  while (open.length < 8) {\n    d.setDate(d.getDate() + 1); if (!(d.getDay() % 6)) continue;\n    const day = d.toLocaleDateString('en-US', { weekday: 'long', month: 'short', day: 'numeric' });\n    for (const t of ['9:00 am', '10:30 am', '2:00 pm', '3:30 pm']) if (!taken.has(day + ' ' + t) && open.length < 8) open.push(day + ' ' + t);\n  }\n  return [{ json: { ...$('Tidy the message').first().json, open } }];"
      }
    },
    {
      "id": "5h0wca5e-0011-4000-8000-000000000008",
      "name": "Build Claude request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const m = $json;\n  const facts = $('Load what the bot knows').all().map(i => i.json).filter(r => r.Business === m.business).map(r => `- ${r.Topic}: ${r.Answer}`).join('\\n');\n  const history = $('Load the conversation').all().map(i => i.json).filter(r => r.Session === m.session).slice(-14).map(r => ({ role: r.Who === 'Visitor' ? 'user' : 'assistant', content: String(r.Message) }));\n  const system = `You are the WhatsApp assistant for Brightside Family Clinic. Write like a friendly front desk: short messages (under 50 words), plain words, no emojis.\nAnswer ONLY from these notes:\n${facts}\n\nBOOKING. Free slots right now (offer two or three at a time, never any other time):\n${m.open.map(s => '- ' + s).join('\\n')}\nTo book you need: the patient's name, the appointment type (New patient visit, Check-up or Follow-up) and one of the free slots above. Ask for what is missing, one question at a time.\nNEVER ask why they want to be seen and never give medical advice. If they describe symptoms or anything urgent, give the urgent-problems note. If they ask for a person, hand off.\nReply with ONLY a JSON object:\n{\"reply\": \"your WhatsApp message\", \"action\": \"none\" | \"book\" | \"handoff\", \"booking\": {\"name\": \"\", \"type\": \"\", \"slot\": \"copied exactly from the list\"} or null}\nUse \"book\" only in the message where you confirm the booking.`;\n  return [{ json: { ...m, body: { model: 'claude-sonnet-5-5', max_tokens: 500, system, messages: [...history, { role: 'user', content: m.text }] } } }];"
      }
    },
    {
      "id": "5h0wca5e-0011-4000-8000-000000000009",
      "name": "Claude: write the reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "options": {
          "timeout": 120000
        },
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "anthropicApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "id": "5h0wca5e-0011-4000-8000-000000000010",
      "name": "Check the booking",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const raw = ($json.content || []).filter(c => c.type === 'text').map(c => c.text).join('');\nlet ai = null;\nfor (let i = raw.indexOf('{'); i >= 0 && !ai; i = raw.indexOf('{', i + 1)) {\n  let depth = 0, inStr = false, esc = false;\n  for (let k = i; k < raw.length; k++) {\n    const ch = raw[k];\n    if (inStr) { if (esc) esc = false; else if (ch === '\\\\') esc = true; else if (ch === '\"') inStr = false; }\n    else if (ch === '\"') inStr = true;\n    else if (ch === '{') depth++;\n    else if (ch === '}' && --depth === 0) { try { ai = JSON.parse(raw.slice(i, k + 1)); } catch (e) {} break; }\n  }\n}\nif (!ai) throw new Error('Claude did not return JSON: ' + raw.slice(0, 200));\n  const m = $('Build Claude request').first().json;\n  let reply = String(ai.reply || '').trim().slice(0, 700) || 'Sorry, I did not catch that. Could you say it another way?';\n  let action = ['book', 'handoff'].includes(ai.action) ? ai.action : 'none', booking = null;\n  if (action === 'book') {\n    const b = ai.booking || {}, types = ['New patient visit', 'Check-up', 'Follow-up'];\n    if (b.name && types.includes(b.type) && m.open.includes(b.slot)) {\n      const cut = b.slot.lastIndexOf(' ', b.slot.lastIndexOf(' ') - 1);\n      booking = { name: String(b.name).slice(0, 80), type: b.type, day: b.slot.slice(0, cut), time: b.slot.slice(cut + 1) };\n    } else { action = 'none'; reply = 'Sorry, that time is not available. I can offer ' + m.open.slice(0, 3).join(', ') + '. Which would you like?'; }\n  }\n  return [{ json: { session: m.session, channel: m.channel, phone: m.phone, time: m.time, text: m.text, reply, action, booking } }];"
      }
    },
